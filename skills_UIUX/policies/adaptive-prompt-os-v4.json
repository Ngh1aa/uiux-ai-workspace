{
  "schema_version": 1,
  "id": "adaptive-prompt-os-v4",
  "description": "Default cross-project website delivery policy: full Prompt OS 0→4 for substantial work, smallest safe lane for bounded local work.",
  "default_for": ["website"],
  "lane_selection": {
    "default_substantial_lane": "full_prompt_os",
    "default_bounded_lane": "lightweight",
    "substantial_scopes": ["page", "multi-page", "journey", "whole-site", "system"],
    "substantial_types": ["build", "redesign", "rebuild"],
    "lightweight_scopes": ["local", "component"],
    "escalation_triggers": [
      "shared_owner",
      "structural_change",
      "cross_route_risk",
      "art_direction_change",
      "new_design_contract_required",
      "production_or_high_risk",
      "material_regression_scope",
      "invalidated_assumption"
    ]
  },
  "full_prompt_os": {
    "phases": [
      {
        "id": 0,
        "name": "project_config",
        "broad_code_allowed": false,
        "exit": "project truth, mode, scope, responsive scope, source of truth, system reality and release authority are resolved"
      },
      {
        "id": 1,
        "name": "research_audit_design_contract",
        "broad_code_allowed": false,
        "exit": "due-now BLOCKED=0 and UNACCOUNTED=0; structural Design Contract and verification plan are sufficient"
      },
      {
        "id": 2,
        "name": "structural_implementation",
        "broad_code_allowed": true,
        "exit": "representative surfaces pass rendered inspection before broad rollout; scoped implementation and regressions are verified"
      },
      {
        "id": 3,
        "name": "final_qa_remediation",
        "broad_code_allowed": true,
        "exit": "rendered cross-page/system QA passes; latest material visual change receives human KEEP/REVISE/REMOVE review and no due-now P0/P1 blocker remains"
      },
      {
        "id": 4,
        "name": "release_production_smoke",
        "broad_code_allowed": false,
        "exit": "release is N/A_JUSTIFIED or authorized release plus real production smoke passes"
      }
    ],
    "representative_gate": {
      "required_for": ["multi-page", "journey", "whole-site", "system"],
      "selection": "actual sitemap + page-role matrix + critical journeys + risk",
      "count_guidance": "2-4 representative surfaces unless project evidence justifies another number",
      "requires_opened_rendered_evidence": true
    },
    "human_visual_veto": {
      "required_for_substantial_visual_work": true,
      "verdicts": ["KEEP", "REVISE", "REMOVE"],
      "automated_score_cannot_override_visible_defect": true
    }
  },
  "lightweight": {
    "sequence": [
      "project_truth",
      "scope_type_risk_mode",
      "smallest_applicable_skill_graph",
      "root_owner_inspection",
      "focused_implementation",
      "focused_rendered_or_browser_verification",
      "affected_shared_owner_regression",
      "authorized_release_if_requested"
    ],
    "manufacture_full_phase_artifacts": false
  },
  "non_negotiable": {
    "system_reality_labels": ["REAL", "MOCK", "STATIC", "SIMULATED", "PARTIAL", "UNKNOWN"],
    "requirement_states": ["DONE_VERIFIED", "N/A_JUSTIFIED", "PENDING_FUTURE_PHASE", "BLOCKED"],
    "build_success_is_not_rendered_visual_qa": true,
    "screenshot_must_be_opened_for_visual_evidence": true,
    "visible_broken_screenshot_is_failure": true,
    "substantial_redesign_must_be_structural_not_cosmetic": true,
    "release_requires_authorization": true
  },
  "release": {
    "authorizations": ["no_release", "create_pr_only", "merge_only", "merge_and_deploy"],
    "production_smoke_required_when_deployed": true,
    "deploy_success_is_not_production_verification": true,
    "verify_stale_assets_or_version": true
  },
  "precedence": [
    "current_user_request",
    "project_profile_and_truth",
    "passed_project_design_contract",
    "default_delivery_policy",
    "routed_specialist_skills",
    "generic_model_prior"
  ]
}
