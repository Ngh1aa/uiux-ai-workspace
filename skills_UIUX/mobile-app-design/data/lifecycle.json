{
  "schema_version": "1.0",
  "owner": "mobile-app-design",
  "boundary": "Design/prototype work cards only. Shared Flow OS and delivery checker remain canonical; no native runtime, human validation or release approval is inferred.",
  "stages": {
    "research": {
      "decision": "Which mobile task, target truth and evidence justify the design?",
      "exit_checks": [
        "Platform/output/scope and baseline explicit",
        "Source-to-decision trace and actual participant access declared",
        "UX walkthrough precedes visual direction: current state, next action and recovery are understandable"
      ],
      "deliverables": [
        {
          "id": "research.mobile_brief",
          "output": "mobile brief and baseline inventory",
          "fields": [
            "problem/audience/top tasks",
            "platform/OS/device/stack or UNKNOWN",
            "screen/state inventory and preserved components",
            "authority and excluded native implementation/release",
            "screen job, priority order, CTA destination, feedback and recovery",
            "wireframe walkthrough observations, blockers and retest; agent review is not user research"
          ],
          "resources": [
            "mobile-app-design/SKILL.md",
            "product-discovery/SKILL.md"
          ]
        },
        {
          "id": "research.mobile_evidence",
          "output": "source-to-decision and research plan",
          "fields": [
            "source/pin/license",
            "ADOPT/ADAPT/REJECT and screen/state verification",
            "desk/scenario/direct-user evidence separated",
            "PLANNED_VALIDATION without actual sessions"
          ],
          "resources": [
            "mobile-app-design/data/sources.json",
            "research-evidence-pipeline/SKILL.md"
          ]
        }
      ]
    },
    "design": {
      "decision": "Which navigation, platform behavior and component system serves the task?",
      "exit_checks": [
        "Screen/state paths include relevant failure/recovery",
        "Platform differences and accessibility annotations explicit",
        "Prototype/design evidence current; native runtime still UNKNOWN"
      ],
      "deliverables": [
        {
          "id": "design.mobile_contract",
          "output": "mobile design contract and navigation/state inventory",
          "fields": [
            "entry/task/state/transition",
            "back/dismiss/keyboard/permissions/offline when relevant",
            "brand/component reuse and platform mapping",
            "source-to-decision trace and current revision",
            "overview / selection / form representative compositions and justified inheritance",
            "canonical v2 design-decisions.json with reference transfers and numeric roles"
          ],
          "resources": [
            "mobile-app-design/templates/mobile-design-contract.md",
            "mobile-navigation-and-state-ux/SKILL.md",
            "visual-design-direction/SKILL.md",
            "visual-design-direction/references/mobile-ux-first.md"
          ]
        },
        {
          "id": "design.mobile_system",
          "output": "tokens/components and implementation handoff",
          "fields": [
            "semantic tokens and native units",
            "component variants/states/semantics",
            "stack/OS availability and asset rights",
            "real/mock/simulated data and owner"
          ],
          "resources": [
            "mobile-design-system-and-handoff/SKILL.md"
          ]
        },
        {
          "id": "design.mobile_prototype",
          "output": "critical-task prototype and review plan",
          "fields": [
            "task success and consequential recovery",
            "actual captures/revision and observed findings",
            "expert versus actual participant evidence",
            "prototype limits and native checks NOT_RUN"
          ],
          "resources": [
            "mobile-prototype-and-qa/SKILL.md",
            "mobile-app-design/templates/mobile-qa-matrix.md"
          ]
        }
      ]
    },
    "qa": {
      "decision": "What design/prototype evidence is inspected and what native work remains?",
      "exit_checks": [
        "Current captures/findings and handoff records reviewed",
        "File coverage does not claim aesthetics/native QA",
        "Missing runtime/user/store evidence stays UNKNOWN",
        "Task comprehension before visual craft; actual captures opened and reviewed",
        "Seven visual signs with location and purpose; no automatic beauty PASS"
      ],
      "deliverables": [
        {
          "id": "qa.mobile_review",
          "output": "design/prototype review and issue log",
          "fields": [
            "critical tasks/states/platform conditions",
            "observations/severity/owner/retest",
            "large text/dark/motion/accessibility annotations",
            "evidence type and limitations"
          ],
          "resources": [
            "mobile-prototype-and-qa/SKILL.md",
            "ui-craft-and-visual-qa/SKILL.md"
          ]
        },
        {
          "id": "qa.mobile_handoff",
          "output": "design handoff and native verification plan",
          "fields": [
            "current artifact records and hashes",
            "platform/component/data/license owners",
            "native build/device/a11y/performance matrix",
            "scope-specific PASS/FAIL/NOT_RUN/UNKNOWN and release boundary"
          ],
          "resources": [
            "mobile-app-design/checklists/design-handoff.md",
            "mobile-app-design/templates/mobile-qa-matrix.md"
          ]
        }
      ]
    }
  },
  "sources_reviewed_on": "2026-10-14",
  "browser_preview_stages": {
    "implementation": {
      "decision": "Which shared renderer/state and static output delivers the mobile design in a browser?",
      "exit_checks": [
        "Source/components/tokens reused",
        "Critical tasks and recovery work",
        "Hosting subpath and direct state links verified"
      ],
      "deliverables": [
        {
          "id": "implementation.mobile_browser_prototype",
          "output": "interactive browser prototype and static export",
          "fields": [
            "canonical screen/state renderer",
            "demo fixtures and reset",
            "existing stack/build output",
            "native simulations and real integration limits"
          ],
          "resources": [
            "mobile-web-preview/SKILL.md",
            "frontend-implementation/SKILL.md"
          ]
        },
        {
          "id": "implementation.mobile_preview_hosting",
          "output": "authorized target hosting configuration or prepared assets",
          "fields": [
            "target repository and current source revision",
            "base path and exported routes/assets",
            "publication authority and PREPARED status until verified"
          ],
          "resources": [
            "mobile-web-preview/references/hosting-and-verification.md"
          ]
        }
      ]
    },
    "qa": {
      "decision": "What actual browser and deployment evidence justifies the client handoff?",
      "exit_checks": [
        "Current browser task/recovery captures inspected",
        "Phone and desktop/subpath tests pass",
        "Client URL verified or explicitly pending; native runtime NOT_RUN",
        "Task comprehension before visual craft; actual captures opened and reviewed",
        "Seven visual signs with location and purpose; no automatic beauty PASS"
      ],
      "deliverables": [
        {
          "id": "qa.mobile_browser_evidence",
          "output": "browser interaction, state and capture evidence",
          "fields": [
            "source revision/viewports and observed tasks",
            "console/network/assets and route reload",
            "findings/owner/retest",
            "browser versus native evidence boundary"
          ],
          "resources": [
            "mobile-web-preview/SKILL.md",
            "mobile-prototype-and-qa/SKILL.md",
            "ui-craft-and-visual-qa/SKILL.md"
          ]
        },
        {
          "id": "qa.mobile_client_handoff",
          "output": "prepared assets or verified hosted link and client instructions",
          "fields": [
            "PREPARED/DEPLOYED_VERIFIED/BLOCKED/UNKNOWN",
            "provider SHA/status and live URL evidence",
            "optional QR from confirmed URL",
            "demo/reset/native/backend/user limits"
          ],
          "resources": [
            "mobile-web-preview/templates/client-handoff.md",
            "mobile-web-preview/references/hosting-and-verification.md"
          ]
        }
      ]
    }
  }
}
