{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ngh1aa/skills_UIUX/schemas/uiux-profile.schema.json",
  "title": "skills_UIUX Project Profile",
  "type": "object",
  "required": ["schema_version", "profile"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"enum": [1, 2]},
    "profile": {"type": "string", "minLength": 1},
    "packs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true, "default": []},
    "additional_skills": {"type": "array", "items": {"type": "string"}, "uniqueItems": true, "default": []},
    "exclude_skills": {"type": "array", "items": {"type": "string"}, "uniqueItems": true, "default": []},
    "project": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "name": {"type": "string"},
        "mode": {"type": "string"},
        "domain": {"type": "string"}
      }
    },
    "source_of_truth": {"type": "array", "items": {"type": "string"}, "uniqueItems": true, "default": []},
    "constraints": {"type": "array", "items": {"type": "string"}, "uniqueItems": true, "default": []}
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": 1}}},
      "then": {"properties": {"packs": {"maxItems": 0}}}
    }
  ]
}
