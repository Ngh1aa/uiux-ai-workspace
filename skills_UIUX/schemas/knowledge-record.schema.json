{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uiux-factory.local/schemas/knowledge-record.schema.json",
  "title": "UIUX Knowledge Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "category",
    "topic",
    "summary",
    "content_ref",
    "source_ref",
    "source_kind",
    "version",
    "updated_at",
    "freshness",
    "confidence",
    "advisory_only",
    "current_run_evidence",
    "authority_effect",
    "gate_effect",
    "evidence_effect",
    "release_effect"
  ],
  "properties": {
    "schema_version": {"const": "knowledge-record.v1"},
    "id": {"type": "string", "minLength": 1, "maxLength": 128},
    "title": {"type": "string", "minLength": 1, "maxLength": 300},
    "category": {
      "type": "string",
      "enum": ["foundations", "product", "research", "management", "domain", "pattern", "platform"]
    },
    "topic": {"type": "string", "minLength": 1, "maxLength": 256},
    "summary": {"type": "string", "minLength": 1, "maxLength": 4000},
    "content_ref": {"type": "string", "minLength": 1, "maxLength": 512},
    "source_ref": {"type": "string", "minLength": 1, "maxLength": 1024},
    "source_kind": {
      "type": "string",
      "enum": ["repo_reference", "external_reference", "standard", "human_curated"]
    },
    "version": {"type": "string", "minLength": 1, "maxLength": 128},
    "updated_at": {"type": "string", "minLength": 1, "maxLength": 128},
    "freshness": {"type": "string", "enum": ["evergreen", "versioned", "time_sensitive"]},
    "confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "applicable_domains": {
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 128}
    },
    "applicable_stages": {
      "type": "array",
      "maxItems": 30,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 128}
    },
    "tags": {
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 128}
    },
    "advisory_only": {"const": true},
    "current_run_evidence": {"const": false},
    "authority_effect": {"const": "none"},
    "gate_effect": {"const": "none"},
    "evidence_effect": {"const": "none"},
    "release_effect": {"const": "none"}
  }
}
