{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uiux-factory.local/schemas/external-task-manifest.schema.json",
  "title": "UIUX Factory External Task Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "target_repository",
    "task",
    "authority",
    "task_contract",
    "resolved_flow",
    "stages",
    "acceptance_criteria",
    "canonical_sources",
    "research_packet",
    "evidence_boundary"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "status": {"const": "READY_FOR_EXTERNAL_COLLABORATOR"},
    "target_repository": {"type": "string", "minLength": 1},
    "task": {"type": "string", "minLength": 1},
    "authority": {
      "type": "string",
      "enum": ["read_only", "branch_write", "external_write", "release"]
    },
    "task_contract": {"type": "object"},
    "resolved_flow": {
      "type": "object",
      "required": ["id", "source", "stages"]
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "agent", "skills", "skill_paths", "gates", "load_policy"]
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {"type": "string"}
    },
    "qa_routes": {
      "type": "array",
      "items": {"type": "string"}
    },
    "canonical_sources": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "research_packet": {"type": "object"},
    "evidence_boundary": {
      "type": "object",
      "required": [
        "manifest_is_not_qa_pass",
        "target_repository_audit_required_before_mutation",
        "target_runtime_evidence_required_for_runtime_claims"
      ]
    }
  }
}
