{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uiux-factory.local/schemas/knowledge-index.schema.json",
  "title": "UIUX Knowledge Index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "records"],
  "properties": {
    "schema_version": {"const": "knowledge-index.v1"},
    "records": {
      "type": "array",
      "maxItems": 5000,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^records/[A-Za-z0-9._/-]+\\.json$"
      }
    }
  }
}
