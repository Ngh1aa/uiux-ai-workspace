    @classmethod
    def policy_checks(
        cls,
        html_content: str,
        css_content: str,
        skills_loaded: int,
        visual_ready: bool,
    ) -> dict[str, bool]:
        lowered = html_content.lower()

        semantic = all(
            token in lowered
            for token in (
                "<header",
                "<nav",
                "<main",
                "<section",
                "<footer",
            )
        )

        technical_copy_absent = not any(
            term in lowered
            for term in cls.TECHNICAL_COPY
        )

        return {
            "required_skills_loaded": (
                skills_loaded >= 8
            ),
            "visual_composition_consumed": (
                visual_ready
            ),
            "semantic_html": semantic,
            "responsive_css": (
                "@media" in css_content
            ),
            "focus_visible": (
                ":focus-visible"
                in css_content
            ),
            "reduced_motion": (
                "prefers-reduced-motion"
                in css_content
            ),
            "technical_copy_absent": (
                technical_copy_absent
            ),
            "root_relative_static_links": (
                'href="./'
                in html_content
