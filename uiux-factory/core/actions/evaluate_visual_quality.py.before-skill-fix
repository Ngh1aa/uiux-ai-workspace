import json
from pathlib import Path
from typing import ClassVar

from metagpt.actions import Action

from core.contracts.browser_qa_schema import BrowserQAResult
from core.contracts.visual_critic_schema import (
    RepairDirective,
    VisualCriticGate,
    VisualCriticResult,
    VisualIssue,
    VisualScore,
)
from core.skills.policy_resolver import SkillPolicyResolver


class EvaluateVisualQuality(Action):
    name: str = "EvaluateVisualQuality"

    desc: str = (
        "Evaluate rendered browser evidence using deterministic "
        "visual heuristics plus skills_UIUX policy gates."
    )

    CRITIC_SKILLS: ClassVar[tuple[str, ...]] = (
        "ui-craft-and-visual-qa/SKILL.md",
        "visual-taste-calibration/SKILL.md",
        "visual-regression-and-design-drift/SKILL.md",
        "typography/SKILL.md",
        "responsive-and-device-strategy/SKILL.md",
        "accessibility/SKILL.md",
    )

    @staticmethod
    def clamp(
        value: float,
    ) -> int:
        return max(
            0,
            min(
                100,
                int(round(value)),
            ),
        )

    @staticmethod
    def image_metrics(
        screenshot: Path,
    ) -> dict[str, float]:
        try:
            from PIL import Image
        except ImportError as exc:
            raise RuntimeError(
                "Pillow is required for VisualCritic. "
                "Run: python -m pip install pillow"
            ) from exc

        with Image.open(
            screenshot
        ).convert("RGB") as image:
            width, height = image.size

            sample = image.resize(
                (
                    min(width, 220),
                    min(height, 220),
                )
            )

            pixels = list(
                sample.getdata()
            )

            total = max(
                1,
                len(pixels),
            )

            light = 0
            dark = 0
            saturated = 0

            for r, g, b in pixels:
                luminance = (
                    0.2126 * r
                    + 0.7152 * g
                    + 0.0722 * b
                )

                if luminance > 245:
                    light += 1

                if luminance < 28:
                    dark += 1

                delta = (
                    max(r, g, b)
                    - min(r, g, b)
                )

                if delta > 55:
                    saturated += 1

            return {
                "width": float(width),
                "height": float(height),
                "white_ratio": (
                    light / total
                ),
                "dark_ratio": (
                    dark / total
                ),
                "saturated_ratio": (
                    saturated / total
                ),
            }

    @staticmethod
    def score_browser(
        qa: BrowserQAResult,
    ) -> tuple[int, int]:
        responsive = 100
        accessibility = 100

        overflow_count = int(
            qa.summary.get(
                "overflow_count",
                0,
            )
        )

        page_errors = int(
            qa.summary.get(
                "page_error_count",
                0,
            )
        )

        broken_links = int(
            qa.summary.get(
                "broken_link_count",
                0,
            )
        )

        responsive -= (
            overflow_count * 18
        )

        if not (
            qa.gates
            .semantic_smoke_passed
        ):
            accessibility -= 22

        if page_errors:
            accessibility -= min(
                30,
                page_errors * 8,
            )

        if broken_links:
            accessibility -= min(
                20,
                broken_links * 4,
            )

        return (
            max(0, responsive),
            max(0, accessibility),
        )

    @classmethod
    def visual_heuristics(
        cls,
        qa: BrowserQAResult,
    ) -> tuple[
        dict[str, int],
        list[VisualIssue],
    ]:
        issues = []
        metrics = []

        for item in qa.evidence:
            screenshot = Path(
                item.screenshot
            )

            if not screenshot.exists():
                issues.append(
                    VisualIssue(
                        severity="P0",
                        category="evidence",
                        route=item.route,
                        viewport=item.viewport.name,
                        evidence=(
                            "Screenshot file is missing."
                        ),
                        recommendation=(
                            "Re-run BrowserQA before visual scoring."
                        ),
                    )
                )
                continue

            current = cls.image_metrics(
                screenshot
            )

            current[
                "route"
            ] = item.route

            current[
                "viewport"
            ] = item.viewport.name

            metrics.append(
                current
            )

            if (
                current["white_ratio"]
                > 0.78
            ):
                issues.append(
                    VisualIssue(
                        severity="P1",
                        category="composition",
                        route=item.route,
                        viewport=item.viewport.name,
                        evidence=(
                            "Very high near-white area ratio "
                            f"({current['white_ratio']:.2f}) "
                            "suggests weak density or excessive empty space."
                        ),
                        recommendation=(
                            "Rebalance section rhythm, imagery, "
                            "content density and visual anchors."
                        ),
                    )
                )

            if (
                current["dark_ratio"]
                > 0.60
            ):
                issues.append(
                    VisualIssue(
                        severity="P1",
                        category="surface",
                        route=item.route,
                        viewport=item.viewport.name,
                        evidence=(
                            "Dark surface dominates more than 60% "
                            "of the rendered page."
                        ),
                        recommendation=(
                            "Check whether inverse surfaces are "
                            "overused relative to the visual contract."
                        ),
                    )
                )

        if not metrics:
            return (
                {
                    "visual": 0,
                    "hierarchy": 0,
                    "typography": 0,
                    "spacing": 0,
                    "brand_fidelity": 0,
                    "generic_ai_feel": 100,
                },
                issues,
            )

        avg_white = sum(
            metric[
                "white_ratio"
            ]
            for metric in metrics
        ) / len(metrics)

        avg_sat = sum(
            metric[
                "saturated_ratio"
            ]
            for metric in metrics
        ) / len(metrics)

        route_count = len(
            set(
                metric["route"]
                for metric in metrics
            )
        )

        viewport_count = len(
            set(
                metric["viewport"]
                for metric in metrics
            )
        )

        visual = cls.clamp(
            88
            - max(
                0,
                avg_white - 0.62,
            )
            * 95
        )

        hierarchy = cls.clamp(
            86
            - max(
                0,
                avg_white - 0.70,
            )
            * 75
        )

        typography = 84

        spacing = cls.clamp(
            88
            - max(
                0,
                avg_white - 0.68,
            )
            * 90
        )

        brand_fidelity = cls.clamp(
            82
            + min(
                10,
                avg_sat * 35,
            )
        )

        generic_ai_feel = cls.clamp(
            30
            + (
                10
                if route_count < 4
                else 0
            )
            + (
                8
                if viewport_count < 3
                else 0
            )
            + (
                18
                if avg_white > 0.76
                else 0
            )
        )

        return (
            {
                "visual": visual,
                "hierarchy": hierarchy,
                "typography": typography,
                "spacing": spacing,
                "brand_fidelity": brand_fidelity,
                "generic_ai_feel": generic_ai_feel,
            },
            issues,
        )

    @staticmethod
    def directives_from_issues(
        issues: list[VisualIssue],
    ) -> list[RepairDirective]:
        directives = []

        for index, issue in enumerate(
            issues,
            start=1,
        ):
            directives.append(
                RepairDirective(
                    priority=index,
                    route=issue.route,
                    target=issue.category,
                    instruction=(
                        issue.recommendation
                    ),
                    success_criteria=(
                        "Re-run BrowserQA and VisualCritic; "
                        "the triggering evidence should no "
                        "longer reproduce."
                    ),
                )
            )

        return directives[:12]

    async def run(
        self,
        instruction: str,
    ) -> str:
        payload = json.loads(
            instruction
        )

        report_path = Path(
            payload.get(
                "browser_report_path",
                "",
            )
        ).resolve()

        if not report_path.exists():
            raise FileNotFoundError(
                "Browser report not found: "
                f"{report_path}"
            )

        qa = (
            BrowserQAResult
            .model_validate_json(
                report_path.read_text(
                    encoding="utf-8"
                )
            )
        )

        resolver = (
            SkillPolicyResolver()
        )

        skills_used = []

        for relative_path in (
            self.CRITIC_SKILLS
        ):
            skill = resolver.load(
                relative_path
            )
            skills_used.append(
                skill.name
            )

        browser_responsive, browser_accessibility = (
            self.score_browser(
                qa
            )
        )

        heuristic_scores, issues = (
            self.visual_heuristics(
                qa
            )
        )

        if not (
            qa.gates
            .no_horizontal_overflow
        ):
            issues.append(
                VisualIssue(
                    severity="P0",
                    category="responsive",
                    route="*",
                    viewport="*",
                    evidence=(
                        "BrowserQA detected horizontal overflow."
                    ),
                    recommendation=(
                        "Repair the overflowing component or layout "
                        "before accepting responsive quality."
                    ),
                )
            )

        if not (
            qa.gates
            .internal_links_valid
        ):
            issues.append(
                VisualIssue(
                    severity="P0",
                    category="navigation",
                    route="*",
                    viewport="*",
                    evidence=(
                        "BrowserQA detected broken internal links."
                    ),
                    recommendation=(
                        "Repair route/link targets before final QA."
                    ),
                )
            )

        if not (
            qa.gates
            .no_page_errors
        ):
            issues.append(
                VisualIssue(
                    severity="P0",
                    category="runtime",
                    route="*",
                    viewport="*",
                    evidence=(
                        "BrowserQA reported runtime/page errors."
                    ),
                    recommendation=(
                        "Resolve browser runtime failures before "
                        "visual acceptance."
                    ),
                )
            )

        overall = self.clamp(
            (
                heuristic_scores[
                    "visual"
                ]
                + heuristic_scores[
                    "hierarchy"
                ]
                + heuristic_scores[
                    "typography"
                ]
                + heuristic_scores[
                    "spacing"
                ]
                + browser_responsive
                + heuristic_scores[
                    "brand_fidelity"
                ]
                + browser_accessibility
                + (
                    100
                    - heuristic_scores[
                        "generic_ai_feel"
                    ]
                )
            )
            / 8
        )

        score = VisualScore(
            visual=heuristic_scores[
                "visual"
            ],
            hierarchy=heuristic_scores[
                "hierarchy"
            ],
            typography=heuristic_scores[
                "typography"
            ],
            spacing=heuristic_scores[
                "spacing"
            ],
            responsive=(
                browser_responsive
            ),
            brand_fidelity=(
                heuristic_scores[
                    "brand_fidelity"
                ]
            ),
            accessibility=(
                browser_accessibility
            ),
            generic_ai_feel=(
                heuristic_scores[
                    "generic_ai_feel"
                ]
            ),
            overall=overall,
        )

        directives = (
            self.directives_from_issues(
                issues
            )
        )

        repair_required = (
            overall < 90
            or any(
                issue.severity
                in (
                    "P0",
                    "P1",
                )
                for issue in issues
            )
        )

        screenshots_consumed = bool(
            qa.evidence
        ) and all(
            Path(
                item.screenshot
            ).exists()
            for item in qa.evidence
        )

        result = VisualCriticResult(
            status=(
                "repair_required"
                if repair_required
                else "passed"
            ),
            project_slug=(
                qa.project_slug
            ),
            score=score,
            issues=issues,
            repair_directives=directives,
            skills_used=skills_used,
            gates=VisualCriticGate(
                screenshots_consumed=(
                    screenshots_consumed
                ),
                browser_report_consumed=True,
                skills_loaded=(
                    len(skills_used)
                    == len(
                        self.CRITIC_SKILLS
                    )
                ),
                score_generated=True,
                repair_directives_generated=(
                    bool(directives)
                ),
                ready_for_repair_agent=(
                    repair_required
                    and screenshots_consumed
                ),
            ),
            notes=[
                (
                    "VisualCritic v1 is deterministic and heuristic "
                    "because the current factory is operating without "
                    "a paid vision/LLM provider."
                ),
                (
                    "Scores are useful for regression routing and "
                    "repair triggering, not a substitute for a human "
                    "creative-director review."
                ),
            ],
        )

        return result.model_dump_json(
            indent=2
        )
