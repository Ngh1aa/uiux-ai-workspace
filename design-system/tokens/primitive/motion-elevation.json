{
  "duration": {
    "$type": "duration",
    "instant": { "$value": { "value": 0, "unit": "ms" } },
    "fast": { "$value": { "value": 120, "unit": "ms" }, "$description": "Hover, press, toggle feedback." },
    "base": { "$value": { "value": 200, "unit": "ms" }, "$description": "Small component transitions." },
    "slow": { "$value": { "value": 320, "unit": "ms" }, "$description": "Sheets and panels entering. Anything longer needs a reason." }
  },
  "easing": {
    "$type": "cubicBezier",
    "standard": { "$value": [0.2, 0, 0, 1] },
    "enter": { "$value": [0, 0, 0.2, 1], "$description": "Decelerate: elements arriving on screen." },
    "exit": { "$value": [0.4, 0, 1, 1], "$description": "Accelerate: elements leaving the screen." }
  },
  "shadow": {
    "$type": "shadow",
    "100": {
      "$value": [
        { "color": { "colorSpace": "srgb", "components": [0.1294, 0.1216, 0.1098], "alpha": 0.06, "hex": "#211f1c" }, "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 1, "unit": "px" }, "blur": { "value": 2, "unit": "px" }, "spread": { "value": 0, "unit": "px" } }
      ]
    },
    "200": {
      "$value": [
        { "color": { "colorSpace": "srgb", "components": [0.1294, 0.1216, 0.1098], "alpha": 0.06, "hex": "#211f1c" }, "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 1, "unit": "px" }, "blur": { "value": 2, "unit": "px" }, "spread": { "value": 0, "unit": "px" } },
        { "color": { "colorSpace": "srgb", "components": [0.1294, 0.1216, 0.1098], "alpha": 0.08, "hex": "#211f1c" }, "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 6, "unit": "px" }, "blur": { "value": 16, "unit": "px" }, "spread": { "value": -4, "unit": "px" } }
      ]
    },
    "300": {
      "$value": [
        { "color": { "colorSpace": "srgb", "components": [0.1294, 0.1216, 0.1098], "alpha": 0.08, "hex": "#211f1c" }, "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 2, "unit": "px" }, "blur": { "value": 4, "unit": "px" }, "spread": { "value": 0, "unit": "px" } },
        { "color": { "colorSpace": "srgb", "components": [0.1294, 0.1216, 0.1098], "alpha": 0.14, "hex": "#211f1c" }, "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 16, "unit": "px" }, "blur": { "value": 32, "unit": "px" }, "spread": { "value": -8, "unit": "px" } }
      ]
    }
  }
}
