{
  "$description": "Semantic color roles, light mode. Paths must match the other mode exactly (validate.py enforces parity).",
  "surface": {
    "$type": "color",
    "page": {
      "$value": "{color.neutral.50}"
    },
    "raised": {
      "$value": "{color.neutral.0}"
    },
    "sunken": {
      "$value": "{color.neutral.100}"
    },
    "inverse": {
      "$value": "{color.neutral.950}"
    },
    "brand-subtle": {
      "$value": "{color.jade.50}"
    },
    "brand-strong": {
      "$value": "{color.jade.800}"
    },
    "scrim": {
      "$value": "{color.neutral.950}",
      "$description": "Dims content behind sheets and dialogs. Dark in both modes; apply with opacity."
    }
  },
  "text": {
    "$type": "color",
    "primary": {
      "$value": "{color.neutral.950}"
    },
    "secondary": {
      "$value": "{color.neutral.700}"
    },
    "tertiary": {
      "$value": "{color.neutral.600}"
    },
    "disabled": {
      "$value": "{color.neutral.500}",
      "$description": "Exempt from contrast minimums (WCAG 1.4.3 inactive components). Never use for information the user needs."
    },
    "brand": {
      "$value": "{color.jade.700}"
    },
    "on-brand-strong": {
      "$value": "{color.neutral.0}"
    },
    "on-inverse": {
      "$value": "{color.neutral.50}"
    }
  },
  "border": {
    "$type": "color",
    "subtle": {
      "$value": "{color.neutral.200}",
      "$description": "Decorative dividers only. Not sufficient to identify a control."
    },
    "control": {
      "$value": "{color.neutral.600}",
      "$description": "Identifies interactive boundaries; must reach 3:1 against adjacent surfaces (WCAG 1.4.11)."
    },
    "focus": {
      "$value": "{color.blue.600}"
    }
  },
