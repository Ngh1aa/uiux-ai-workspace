# Auto detect text files and perform LF normalization
* text=auto

# New teaching specimens and their evidence are byte-hashed across platforms.
skills_UIUX/visual-design-direction/examples/decision-lab/* text eol=lf
# Frozen pilot responses/inputs keep their original bytes, including any original
# line endings, because reviewer and predeclared records bind those exact bytes.
docs/evidence/ux-knowledge-practice/pilot/** -text -diff

# The specimen review records source-byte hashes; keep them portable across checkouts.
skills_UIUX/visual-design-direction/examples/mobile-care/index.html text eol=lf
skills_UIUX/visual-design-direction/examples/mobile-care/capture.cjs text eol=lf

# Binary/license manifests and reviewed examples bind exact source bytes.
# Preserve the reviewed Windows bytes on Linux CI as well as fresh checkouts.
design-system/fonts/*/OFL.txt -whitespace
benchmarks/report.py -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
design-system/fonts/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
design-system/examples/data-table/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
design-system/examples/gom-moc/app.html -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
design-system/examples/gom-moc/review/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Keep the bundled upstream license text unchanged.
design-system/fonts/*/OFL.txt -whitespace
